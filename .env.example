# =============================================================================
# Brodoudou Social Commerce Platform - Environment Configuration
# Copy to .env and adjust values for local development
# =============================================================================

# Application
APP_NAME=Brodoudou
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
CURRENCY=USD
TIMEZONE=UTC

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Customer Frontend
CUSTOMER_WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Frontend
ADMIN_WEB_PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8000
NEXT_PUBLIC_ADMIN_WS_URL=ws://localhost:8000
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=pindodo
POSTGRES_PASSWORD=pindodo_dev_password
POSTGRES_DB=pindodo
DATABASE_URL=postgresql+asyncpg://pindodo:pindodo_dev_password@localhost:5433/pindodo
DATABASE_URL_SYNC=postgresql://pindodo:pindodo_dev_password@localhost:5433/pindodo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Payments
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
SIMULATE_PAYMENTS=true

# Group Buying Defaults
DEFAULT_GROUP_SIZE=3
DEFAULT_GROUP_EXPIRATION_HOURS=24
MAX_GROUP_SIZE=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Seed
SEED_ON_STARTUP=false
